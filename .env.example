# ===================================================================
# MLS + KHADANE™ Environment Variables
# Copy this file to .env.local for local development.
# Set these in Vercel dashboard for production.
# ===================================================================

# ─── ENQUIRY EMAIL (Resend fallback) ────────────────────────────────
# Get your API key from https://resend.com
# Production requires either RESEND_API_KEY or GOOGLE_ENQUIRY_WEBHOOK_URL.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email addresses (must be verified senders in Resend)
ENQUIRY_FROM_EMAIL=enquiries@mohanlalsonsgroup.com
ENQUIRY_FROM_NAME=Mohan Lal & Sons

# Routing inboxes (per build prompt §4.4 + Section 10 single-channel lock)
INBOX_OFFICE_MLS=office@mohanlalsonsgroup.com
INBOX_KHADANE_EXPORTS=office@khadane.com

# ─── GOOGLE SHEETS ENQUIRY WEBHOOK ──────────────────────────────────
# Deploy scripts/google-enquiry-webhook.gs as a Google Apps Script Web App.
# The script saves to Google Sheets and sends both owner + customer emails.
GOOGLE_ENQUIRY_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxxxxxxxxxx/exec
GOOGLE_ENQUIRY_WEBHOOK_SECRET=change-this-long-random-secret

# ─── DEV HOST MODE ──────────────────────────────────────────────────
# Used in local dev to lock the dev server to one site.
# Values: mls | khadane | (unset → defaults to MLS)
NEXT_PUBLIC_DEV_HOST_MODE=mls

# ─── PUBLIC SITE URLS ───────────────────────────────────────────────
NEXT_PUBLIC_MLS_URL=https://mohanlalsonsgroup.com
NEXT_PUBLIC_KHADANE_URL=https://khadane.com

# ─── OPTIONAL: CLOUDFLARE TURNSTILE ─────────────────────────────────
# Flagged in build prompt §4.4. Set both to enable CAPTCHA on enquiry form.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── ENVIRONMENT NAME ───────────────────────────────────────────────
# development | staging | production
APP_ENV=development

# --- KHADANE Assistant (Groq) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile




# ─── ADMIN COMMAND CENTRE ───────────────────────────────────────
# Sign-in password for /admin (required in production)
ADMIN_PASSWORD=change-me-strong-password
# Optional HMAC secret for session cookies (falls back to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=change-me-long-random-secret

# ─── ADMIN ACCESS GATE (pre-login) ──────────────────────────────
# Hides the /admin login page from anyone without this secret. Enforced at
# the edge (proxy.ts). Unauthorized visitors get a 404 — the panel appears
# not to exist. Authorized people unlock a device ONCE per browser via:
#   https://<your-domain>/admin?k=THE_SECRET_BELOW
# then a 30-day cookie keeps them in. Unset locally = gate disabled (dev).
ADMIN_GATE_SECRET=change-me-long-random-gate-secret

# ─── ADMIN DATABASE (Neon primary + MongoDB backup) ─────────────
# Neon Postgres — SOURCE OF TRUTH for the admin store (enquiries,
# shipments, tasks, alerts, verticals, sites, mines, activity).
# REQUIRED in production: without it the store falls back to a local
# JSON file, which does NOT persist on Vercel.
# Create a project at https://neon.tech and copy the pooled connection
# string (the host contains "-pooler").
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# MongoDB backup mirror (optional but recommended). Every store write is
# mirrored: latest snapshot + 30 days of point-in-time history.
# Create a free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGODB_DB=mls_admin
