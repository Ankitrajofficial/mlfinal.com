# ===================================================================
# MLS + KHADANE™ Environment Variables
# Copy this file to .env.local for local development.
# Set these in Vercel dashboard for production.
# ===================================================================

# ─── ENQUIRY EMAIL (Resend fallback) ────────────────────────────────
# Get your API key from https://resend.com
# Production requires either RESEND_API_KEY or GOOGLE_ENQUIRY_WEBHOOK_URL.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email addresses (must be verified senders in Resend)
ENQUIRY_FROM_EMAIL=enquiries@mohanlalsonsgroup.com
ENQUIRY_FROM_NAME=Mohan Lal & Sons

# Routing inboxes (per build prompt §4.4 + Section 10 single-channel lock)
INBOX_OFFICE_MLS=office@mohanlalsonsgroup.com
INBOX_KHADANE_EXPORTS=office@khadane.com

# ─── GOOGLE SHEETS ENQUIRY WEBHOOK ──────────────────────────────────
# Deploy scripts/google-enquiry-webhook.gs as a Google Apps Script Web App.
# The script saves to Google Sheets and sends both owner + customer emails.
GOOGLE_ENQUIRY_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxxxxxxxxxx/exec
GOOGLE_ENQUIRY_WEBHOOK_SECRET=change-this-long-random-secret

# ─── DEV HOST MODE ──────────────────────────────────────────────────
# Used in local dev to lock the dev server to one site.
# Values: mls | khadane | (unset → defaults to MLS)
NEXT_PUBLIC_DEV_HOST_MODE=mls

# ─── PUBLIC SITE URLS ───────────────────────────────────────────────
NEXT_PUBLIC_MLS_URL=https://mohanlalsonsgroup.com
NEXT_PUBLIC_KHADANE_URL=https://khadane.com

# ─── OPTIONAL: CLOUDFLARE TURNSTILE ─────────────────────────────────
# Flagged in build prompt §4.4. Set both to enable CAPTCHA on enquiry form.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── ENVIRONMENT NAME ───────────────────────────────────────────────
# development | staging | production
APP_ENV=development

# --- KHADANE Assistant (Groq) ---
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
